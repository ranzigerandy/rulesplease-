# Frontend mode: "convex" for the migrated app, "local" for rollback.
NEXT_PUBLIC_RULES_BACKEND=convex

# Clerk account management. `clerk env pull` writes the real keys locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_FRONTEND_API_URL=https://model-termite-83.clerk.accounts.dev
# Optional. When set, use an absolute same-origin URL ending in `/__clerk/`.
NEXT_PUBLIC_CLERK_PROXY_URL=

# Written by `npx convex dev` after linking a persistent deployment.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=

# Existing Python catalogue/API server.
LEGACY_API_URL=http://localhost:4173
NEXT_PUBLIC_LEGACY_API_URL=http://localhost:4173

# Server-only email delivery for account-deletion requests. Configure in Vercel too.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Set the same values on the Convex deployment with `npx convex env set`.
RULES_PLEASE_WORKER_SECRET=
RULES_PLEASE_MIGRATION_SECRET=
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Python worker only. Keep 0 while PDFs remain local in the first phase.
RULES_PLEASE_UPLOAD_PDFS=0
